{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:best-practices",
    "helpers:pinGitHubActionDigestsToSemver",
    ":separateMultipleMajorReleases",
  ],
  packageRules: [
    {
      dependencyDashboardApproval: true,
      matchCategories: ["!ci", "!docker"],
    },
    {
      description: "Bundles all patches into 1 easy to review pr",
      groupName: "all [patches]",
      matchCategories: ["ci", "docker"],
      matchUpdateTypes: ["patch", "digest"],
      schedule: ["before 6am every weekday"],
    },
    {
      description: "Bundle all minor infra updates into 1 update",
      groupName: "infra [minor]",
      matchCategories: ["ci", "docker"],
      matchUpdateTypes: ["minor"],
      schedule: ["before 8am on Monday"],
    },
    {
      description: "Allow major ci updates to be raised each Monday without approval",
      matchCategories: ["ci", "docker"],
      matchUpdateTypes: ["major"],
      schedule: ["before 8am on Monday"],
    },
  ],
}
