ARG BASE_IMAGE=alpine:3.24.4@sha256:93b41ef40b1677fce8fcc64ff4af09daddfacf5040afde618bc46c1e2d1cc7d4

FROM ${BASE_IMAGE} AS final

RUN apk update

RUN apk add --update alpine-sdk \
    && apk add cmake g++ \
    git autoconf libtool linux-headers \
    openssl openssl-dev \
    libevent-dev

WORKDIR /work
